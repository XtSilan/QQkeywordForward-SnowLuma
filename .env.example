# ============================================================
# QQkeywordForward-SnowLuma 运行配置模板
# 复制为 .env.prod（chmod 600）后按注释替换；.env.prod 不入库。
# ============================================================

APP_ENV=prod
ENVIRONMENT=prod
APP_HOST=0.0.0.0
APP_PORT=8080

# 控制台会话
ADMIN_TOKEN=请替换为高强度随机字符串
AUTH_SESSION_SECRET=请替换为另一组高强度随机字符串
AUTH_SESSION_TTL=86400
# 走 HTTPS 时保持 true；只走 HTTP 反向代理时必须是 false，否则登录后 Cookie 不回传。
AUTH_COOKIE_SECURE=false

# --- SnowLuma（OneBot 实现，替代 NapCat） ---
# 镜像：官方 motricseven7/snowluma；国内可指向镜像源，如
#   SNOWLUMA_IMAGE=docker.1ms.run/motricseven7/snowluma:latest
SNOWLUMA_IMAGE=motricseven7/snowluma:latest
SNOWLUMA_CONTAINER_NAME=qq-bot-snowluma
SNOWLUMA_WEBUI_URL=http://snowluma:5099
# WebUI 管理员密码：留空则用容器日志里的初始密码走初始化流程，并改为随机强密码后落 data/
SNOWLUMA_WEBUI_PASSWORD=
# 远程桌面密码：显式固定，noVNC 才能自动填密（留空则容器随机生成、只在日志打印一次）
VNC_PASSWD=
SNOWLUMA_LOG_LEVEL=info
SNOWLUMA_SCREEN=1920x1080x24
SNOWLUMA_UID=1000
SNOWLUMA_GID=1000
SNOWLUMA_QQ_FLAGS=--disable-gpu --disable-software-rasterizer --disable-gpu-compositing

# 允许在控制台里用 Docker socket 读取 snowluma 日志 / 重启 snowluma 进程
CONTROL_ENABLED=true
DOCKER_SOCKET=/var/run/docker.sock
NONEBOT_CONTAINER_NAME=qq-bot-nonebot
WEBUI_CONTAINER_NAME=qq-bot-webui

# --- OneBot V11 鉴权 ---
# ONEBOT_ACCESS_TOKEN：控制台写入 SnowLuma 的 wsClient 用作 Bearer
# ONEBOT_V11_ACCESS_TOKEN：NoneBot 适配器校验入站连接
# 两者必须填相同值；都留空则不鉴权（仅限内网）。
ONEBOT_ACCESS_TOKEN=
ONEBOT_V11_ACCESS_TOKEN=
# SnowLuma 侧 OneBot HTTP（容器内固定 3000）
ONEBOT_HTTP_URL=http://snowluma:3000
# NoneBot 反向 WS 入口（容器内固定 8081），SnowLuma 作为 wsClient 连过去
ONEBOT_WS_URL=ws://nonebot:8081/onebot/v11/ws
ONEBOT_V11_SECRET=

# --- SMTP（不使用邮件通知可留空） ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=15

PUBLIC_BASE_URL=http://你的服务器IP:18080
MAX_UPLOAD_SIZE_MB=10

# --- CI/CD 更新（deploy/updater） ---
# 触发链：push → GitHub Actions 测试 → 服务器 updater 检测到新版本；
# 但默认只"检测不部署"，由控制台左上角醒目提示、点击后才部署。
UPDATER_ENABLED=true
# 只检测不自动部署（true 时维持旧的自动部署行为，生产默认 false）
UPDATER_AUTO_UPDATE=false
UPDATER_TOKEN=
UPDATER_WEBHOOK_SECRET=
UPDATER_BRANCH=master
UPDATER_POLL_INTERVAL=300

APP_VERSION=dev
APP_BUILD_TIME=

# 构建时 pip 源（nonebot / webui / updater 共用）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# --- 宿主机端口 ---
# 只暴露一个网关端口，其余服务全部走容器网络。
WEBUI_HOST_PORT=18080
